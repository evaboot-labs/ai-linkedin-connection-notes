      "id": "a6e4f1b3-b464-43c1-8d4a-f03d39050ee0",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1520,
        120
      ],
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic"
        }
