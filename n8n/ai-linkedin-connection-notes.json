    {
      "parameters": {
        "jsCode": "\n// Same as notes.py facts: one entry per lead, real fields only, tenure = years * 12 + months.\nconst num = v => { const n = parseFloat(String(v ?? '').replace(/,/g, '')); return isNaN(n) ? null : n; };\nconst words = s => String(s || '').split(/\\s+/).join(' ').trim();\nconst prospects = $json.structuredContent.result.prospects || [];\nif (!prospects.length) throw new Error('The export returned no leads. Check the search in Sales Navigator.');\nconst leads = prospects.map(p => {\n  const months = (num(p['Years in Position']) || 0) * 12 + (num(p['Months in Position']) || 0);\n  return {\n    id: p['Linkedin URL Unique ID'] || p['Linkedin URL Public'] || p['Full Name'],\n    first_name: p['First Name'] || '', name: p['Full Name'] || '',\n    title: String(p['Current Job'] || '').trim(), company: p['Company Name'] || '',\n    months_in_role: months,\n    new_in_role: ['true', 'yes', '1'].includes(String(p['Has New Position']).toLowerCase()) || months < 6,\n    headline: words(p['Profile Headline']), summary: words(p['Profile Summary']).slice(0, 700),\n    posts: p['Posting Frequency'] || '',\n    company_description: words(p['Company Description']).slice(0, 400),\n    company_growth_1y_pct: num(p['Company Employee Growth 1 Year (%)']),\n    linkedin: p['Linkedin URL Public'] || '',\n  };\n});\nreturn [{ json: { leads } }];\n"
      },
      "id": "28c9c657-7e5c-4b3b-aeba-b1898c3258cf",
      "name": "Lead facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.leads) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You write LinkedIn connection notes for a salesperson, from the JSON leads you are given. Use only those facts: never add anything from memory.\n\nFor each lead, return either {id, hook, note} or {id, skip: true, reason}.\nRules:\n1. 300 characters at most, ideally 150 to 220. Start with \"Hi <first_name>,\".\n2. One real hook per note, named in \"hook\": a new role (new_in_role, months_in_role), company growth (company_growth_1y_pct, always with \"in a year\"), or one concrete line of the lead's own headline or summary. Do not mention posts if posts is \"Low\".\n3. No pitch, no link, no product name, no meeting request. No flattery beyond a short congratulation on a new role.\n4. Vary the ending: no ending phrase on more than a third of the notes.\n5. Skip a lead who is not new in role and whose profile has nothing concrete (\"NA\" summary, a bare headline), with the reason.",
          "maxIterations": 3
        }
      },
      "id": "7999dc42-0db5-44ae-a8f5-6a664d13d8c9",
      "name": "Write the notes",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1560,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": {
